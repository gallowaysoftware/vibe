# Copy to .env beside the compose file and fill in.

# The front's own LAN address on the macvlan network — THE fleet address
# every client is configured with.
FRONT_IPV4=REPLACE-with-a-free-LAN-IP

# Path on the Docker host to the llama-swap peers config
# (start from front-config.example.yaml).
FRONT_CONFIG=REPLACE-with-path-to/config.yaml

# The external macvlan network's name (unraid's default is br0).
MACVLAN_NETWORK=br0

# Only needed if a cloud peer is enabled in the front config.
ANTHROPIC_API_KEY=

# Container name (optional).
FRONT_NAME=fleet-front
