# toqui deploy env — copy to `.env` beside the compose file and fill in.
# REPLACE-marked values must be set; the rest have working defaults.

# Path to the toqui repo checkout on the unraid box (build context).
TOQUI_SRC=REPLACE-/mnt/user/appdata/toqui/src

# Postgres password — ALPHANUMERIC ONLY (it's spliced into a postgres:// URL,
# so @ : / ? # $ would break DATABASE_URL). openssl rand -hex 16
POSTGRES_PASSWORD=REPLACE-alnum-password

# JWT signing secret. openssl rand -hex 32
JWT_SECRET=REPLACE-jwt-secret

# The hum front (deploy/hum) — its macvlan LAN IP, NOT the unraid host IP
# (macvlan containers can't reach the host). /v1 is appended by the compose.
HUM_URL=http://172.16.3.211:9000

# Catalog model id for all three toqui tiers. Must be a tool-capable def
# (toqui is a heavy tool-loop client): qwen3.6-27b-tools today. If your trips
# use photos, you need a vision+tools model instead (see README caveat).
TOQUI_MODEL=qwen3.6-27b-tools

# Public URLs behind NPM. The web app (browser) calls the API directly, so
# both need to be real HTTPS names, and the iOS app points at TOQUI_API_URL.
TOQUI_APP_URL=REPLACE-https://toqui.example.com
TOQUI_API_URL=REPLACE-https://api.toqui.example.com

# Registration gate — your domain(s). The API is internet-exposed (the iOS
# app reaches it through NPM), so DON'T leave this open.
ALLOWED_EMAIL_DOMAINS=REPLACE-example.com

# Static macvlan IPs on br0 (must be free on your LAN; riff uses .212).
TOQUI_API_IPV4=172.16.3.213
TOQUI_WEB_IPV4=172.16.3.214

# 0 = keep chat forever (personal deploy). Set N for an N-day purge.
CHAT_RETENTION_DAYS=0
