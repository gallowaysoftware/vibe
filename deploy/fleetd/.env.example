# Copy to .env beside the compose file and fill in.

# fleetd's own LAN address on the macvlan network — the address every
# `vibe cell` command and MCP client is pointed at (hosts.yaml fleetd_url).
FLEETD_IPV4=REPLACE-with-a-free-LAN-IP

# Host directory holding config.yaml + hosts.yaml (see README.md).
FLEETD_CONFIG_DIR=REPLACE-with-path-to/fleetd-config

# Host directory for fleetd state (token, intent.json, leases.json,
# last-seen.json, start-history.json). REQUIRED and must survive container
# recreation — see the state contract in docker-compose.yaml.
FLEETD_STATE_DIR=REPLACE-with-path-to/fleetd-state

# The external macvlan network's name (unraid's default is br0).
MACVLAN_NETWORK=br0

# Timezone for warm schedules (C4).
TZ=UTC

# Container name and image (optional).
FLEETD_NAME=fleetd
FLEETD_IMAGE=vibe-fleetd:latest
